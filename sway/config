# Use windows key as $mod
set $mod Mod4
# Font for window titles.
font pango:monospace 8

# Passes WAYLAND_DISPLAY etc. to systemd/dbus so the screen-sharing portal works
include /etc/sway/config.d/*

exec --no-startup-id ~/code/scripts/steam-desktop-gen.sh

# Sway doesn't read /etc/X11/xorg.conf.d, so the layout is set here too
input type:keyboard xkb_layout gb

# Main monitor shows the wallpaper; the vertical one stays black, as under i3lock
set $lock swaylock -f -u -e -c 000000 -s fill -i DP-3:$HOME/pictures/wallpapers/wallpaper_big.jpg

# Lock after 10 minutes idle (seconds), before suspend, and on loginctl lock-session
exec swayidle -w timeout 600 '$lock' before-sleep '$lock' lock '$lock'

# Use pactl to adjust volume in PulseAudio.
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal
bindsym $mod+Return exec kitty

# kill focused window
bindsym $mod+Shift+q kill

# start rofi
bindsym $mod+d exec --no-startup-id rofi -show drun -disable-history -show-icons

# add gaps to default windows
gaps inner 25
gaps outer 5

# edit gap sizes
## bindsym $mod+s gaps inner current plus 5
## bindsym $mod+Shift+s gaps inner current minus 5

## bindsym $mod+z gaps outer current plus 5
## bindsym $mod+Shift+z gaps outer current minus 5

# toggle split mode betwen vertical and horizontal
bindsym $mod+t split toggle

# reset gap sizes
bindsym $mod+Shift+t gaps inner current set 25; gaps outer current set 5

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# resize focussed window
bindsym $mod+Left resize shrink width 10 px or 10 ppt
bindsym $mod+Right resize grow width 10 px or 10 ppt
bindsym $mod+Up resize grow height 10 px or 10 ppt
bindsym $mod+Down resize shrink height 10 px or 10 ppt

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec "swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'"

###################
# Custom Keybinds #
###################

# launch wow on workspace 3
bindsym $mod+Shift+p exec "kitty --class wow ~/code/scripts/launchwow.sh"; workspace 3

# lock screen
bindsym $mod+Shift+m exec $lock

# lauch discord
bindsym $mod+Shift+d exec "discord"

# launch firefox
bindsym $mod+Shift+f exec "firefox"

# launch spotify
bindsym $mod+shift+s exec "spotify-launcher --skip-update"

# select a region and copy the screenshot to the clipboard
bindsym Print exec grim -g "$(slurp)" - | wl-copy

#######################
# Appearance Settings #
#######################

# Window colours — rendered from theme.conf.tmpl by colors/build.sh
include ~/.config/sway/theme.conf

# Set up monitors. Positions are in logical pixels; the vertical monitor is
# 1080 wide once rotated. transform 90 rotates on the GPU, which is what stops
# the tearing the modesetting Xorg driver had on this output.
output DP-3     mode 2560x1440@59.951Hz pos 1080 541
output HDMI-A-1 mode 1920x1080@60Hz     pos 0 0 transform 90

# desktop backgrounds (sway runs swaybg itself)
output DP-3     bg ~/pictures/wallpapers/wallpaper_big.jpg fill
output HDMI-A-1 bg ~/pictures/wallpapers/vertical_wallpaper.jpg fill

bar {
    swaybar_command waybar
}

# start ckb-next
exec_always ckb-next --background
