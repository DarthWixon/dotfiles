# Generated from starship.toml.tmpl by colors/build.sh — edit that and colors/everforest.ini, not this file.
palette = "everforest"
# Default true prints a blank line before every prompt, including the first.
add_newline = false

format = """
[](bg0)\
$username\
$hostname\
$directory\
[](fg:bg0 bg:bg_dim)\
$git_branch\
$git_status\
[](fg:bg_dim)\
$cmd_duration\
$character
"""

[palettes.everforest]
bg0     = "{{bg0}}"
bg_dim  = "{{bg_dim}}"
fg      = "{{fg}}"
red     = "{{red}}"
orange  = "{{orange}}"
yellow  = "{{yellow}}"
green   = "{{green}}"
aqua    = "{{aqua}}"
blue    = "{{blue}}"
purple  = "{{purple}}"
grey1   = "{{grey1}}"

[directory]
style = "bg:bg0 fg:fg"

[git_branch]
style = "bg:bg_dim fg:green"

[git_status]
style = "bg:bg_dim fg:yellow"

[character]
success_symbol = "[❯](green)"
error_symbol = "[❯](red)"
